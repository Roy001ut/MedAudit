# Database
DATABASE_URL=sqlite:///./medaudit.db
REDIS_URL=redis://redis:6379

# API Keys (required)
CLAUDE_API_KEY=sk-ant-YOUR_KEY_HERE
OPENAI_API_KEY=sk-YOUR_KEY_HERE

# JWT
SECRET_KEY=medaudit-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage
STORAGE_PATH=/tmp/medaudit/uploads
